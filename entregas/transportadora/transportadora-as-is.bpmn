<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Transportadora" targetNamespace="https://sinc-processos.example/modelos/transportadora" exporter="Analisador de processos" exporterVersion="1.0">
  <bpmn:process id="Process_Transportadora" name="Transportadora — operação, cliente e apoios — AS-IS documental" isExecutable="false">
    <bpmn:documentation><![CDATA[Fonte: Mapeamento_AS_IS_Transportadora_5W2H.pdf, versão 1.0, 19/10/2026. Modelo documental não executável. Preserva 30 atividades, 10 decisões, 12 raias e 35 GAPs da análise. Os quatro inícios representam recortes de operação, faturamento, jornada e manutenção; não impõem sincronização nem espera do faturamento pelo acerto. Pontos de pendência não são conclusão operacional: uma tarefa PENDÊNCIA e um fim de recorte documental representam a fronteira do conhecimento. Rotas de modalidade não criam novas alçadas. Relatório associado: transportadora-relatorio.md.]]></bpmn:documentation>
    <bpmn:laneSet id="LaneSet_Transportadora">
